# Copy to .env.local and replace the values below.
NEXTAUTH_URL=http://localhost:3000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=your-generated-value

# A JSON array of exact username/password pairs. Display name is optional.
BLOG_USERS='[{"username":"user","password":"1234","name":"Akhil"}]'

# MongoDB Atlas connection string. Keep this server-side; do NOT prefix with NEXT_PUBLIC_.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=summitstories
